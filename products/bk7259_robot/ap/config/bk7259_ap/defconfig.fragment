# Kconfig fragment for products/bk7259_robot (AP side: bk7259_ap)
CONFIG_BK_OF_PORT_ENABLE=y
CONFIG_BK_OF_CORE_EVENT_ENABLE=y
CONFIG_BK_OF_STORAGE_ENABLE=y
CONFIG_BK_OF_HEALTH_ENABLE=y
CONFIG_BK_OF_BOARD_ENABLE=y
CONFIG_BK_OF_NET_ENABLE=y
CONFIG_BK_OF_BUTTON_ENABLE=y
CONFIG_BK_OF_LED_EFFECT_ENABLE=y
CONFIG_BK_OF_AUDIO_SESSION_ENABLE=y
CONFIG_BK_OF_AUDIO_MIXER_ENABLE=y
CONFIG_BK_OF_VIDEO_FRAME_POOL_ENABLE=y
CONFIG_BK_OF_UI_CORE_ENABLE=y
CONFIG_BK_OF_AI_AGENT_ENABLE=y
CONFIG_BK_XIAOZHI_LEGACY_IOT_COMPAT=n
CONFIG_BK_OF_ESP_COMPAT_ENABLE=y
CONFIG_BK_OF_PRODUCT_MOTION_ENABLE=y
CONFIG_BK_OF_PRODUCT_ROBOT_FACE_ENABLE=y
CONFIG_BK_OF_PRODUCT_BATTERY_POLICY_ENABLE=y
CONFIG_BK_OF_PRODUCT_ROBOT_ENABLE=y
# Proprietary Agora SDK is disabled by default in open-source Xiaozhi mode:
CONFIG_BK_PLUGIN_AGORA_ENABLE=n
# Deferred until 5 OTA partition/size prerequisites are verified on hardware:
CONFIG_BK_OF_OTA_ENABLE=n
