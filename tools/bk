#!/usr/bin/env python3
from __future__ import annotations

import argparse
import sys
from pathlib import Path

TOOLS = Path(__file__).resolve().parent
if str(TOOLS) not in sys.path:
    sys.path.insert(0, str(TOOLS))

from bk_fetch import fetch_dependency, inspect_checkout
from bk_manifest import dependency_dir, profile_manifest, repository_root


def default_root() -> Path:
    return repository_root() / ".bk-deps"


def cmd_doctor(args: argparse.Namespace) -> int:
    manifest = profile_manifest(args.profile)
    root = Path(args.root).expanduser() if args.root else default_root()
    print(f"profile={args.profile} board={manifest['board']}")
    for kind in ("sdk", "solution"):
        dep = manifest.get(kind)
        if dep is None:
            continue
        print(f"locked {kind}: ref={dep['ref']} sha={dep['sha']}")
        if args.dry_run:
            continue
        result = inspect_checkout(dependency_dir(root, kind), dep)
        if not result.ok:
            print(f"FAIL {result.message}", file=sys.stderr)
            return 1
        print(result.message)
    print("doctor: OK" if args.dry_run or root.exists() else "doctor: OK")
    return 0


def cmd_fetch(args: argparse.Namespace) -> int:
    manifest = profile_manifest(args.profile)
    root = Path(args.root).expanduser() if args.root else default_root()
    try:
        fetch_dependency(root, "sdk", manifest["sdk"], args.dry_run)
        if manifest.get("solution") is not None:
            fetch_dependency(root, "solution", manifest["solution"], args.dry_run)
    except (OSError, RuntimeError) as exc:
        print(f"fetch: FAIL {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_env(args: argparse.Namespace) -> int:
    manifest = profile_manifest(args.profile)
    root = Path(args.root).expanduser() if args.root else default_root()
    print(f"SDK_DIR={dependency_dir(root, 'sdk')}")
    if manifest.get("solution") is not None:
        print(f"SOLUTION_DIR={dependency_dir(root, 'solution')}")
    print(f"BOARD={manifest['board']}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="bk")
    sub = parser.add_subparsers(dest="command", required=True)
    for name in ("doctor", "fetch", "env"):
        cmd = sub.add_parser(name)
        cmd.add_argument("--profile", required=True)
        cmd.add_argument("--root")
        cmd.add_argument("--dry-run", action="store_true")
        cmd.set_defaults(handler={"doctor": cmd_doctor, "fetch": cmd_fetch, "env": cmd_env}[name])
    args = parser.parse_args(argv)
    try:
        return args.handler(args)
    except (OSError, ValueError) as exc:
        print(f"{args.command}: FAIL {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
